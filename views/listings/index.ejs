<% layout('layouts/boilerplate') -%>
<%=succmsg%>
<h3>All listings</h3>

<div class="row g-3 listings-list">
  <% for (let list of alllistings) { %>
    <div class="col-12 col-sm-6 col-md-4">
      <a href="/listings/<%= list._id %>" class="card-link">
        <div class="card listing-card">
          <img src="<%= list.image?.url %>" class="card-img-top listing-thumb" alt="<%= list.title %>">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <h5 class="card-title"><%= list.title %></h5>
            <p class="card-text">&#x20B9;<%= list.price != null ? list.price.toLocaleString('en-IN') : 'N/A' %></p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>
