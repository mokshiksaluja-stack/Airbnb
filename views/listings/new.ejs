<% layout('layouts/boilerplate') -%>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <h1 class="text-center mb-4">Create a New Listing</h1>
            <form method="POST" action="/listings" novalidate  class="needs-validation">
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input name="listing[title]" class="form-control" placeholder="Add a catchy title" type="text" required />
                    <div class="invalid-feedback">Please enter a title.</div>
                    <div class="valid-feedback">Title looks good.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" rows="4" placeholder="" required></textarea>
                    <div class="invalid-feedback">Please enter a description.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Image Link</label>
                    <input name="listing[image][url]" class="form-control" placeholder="enter image URL/Link" type="text" />
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Price</label>
                        <input name="listing[price]" class="form-control" placeholder="1200" type="number"  required/>
                        <div class="invalid-feedback">Please enter a valid price.</div>
                        <div class="valid-feedback">Price is valid.</div>

                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">Country</label>
                        <input name="listing[country]" class="form-control" placeholder="India" type="text" required />
                        <div class="invalid-feedback">Please enter a country.</div>
                        <div class="valid-feedback">Country looks good.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Location</label>
                    <input name="listing[location]" class="form-control" placeholder="Jaipur, Rajasthan" type="text"  required/>
                    <div class="invalid-feedback">Please enter a location.</div>
                    <div class="valid-feedback">Location looks good.</div>
                </div>

                <button class="btn btn-dark">Add</button>
            </form>
        </div>
    </div>
</div>